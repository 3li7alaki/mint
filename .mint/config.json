{
  "stack": "bun",
  "packageManager": "bun",
  "gates": {
    "lint": false,
    "types": false,
    "tests": "bun test",
    "coverage": false
  },
  "reviewers": {
    "spec": { "enabled": true, "model": "opus" },
    "quality": { "enabled": true, "model": "sonnet" },
    "security": { "enabled": true, "model": "sonnet" },
    "conventions": { "enabled": true, "model": "haiku" },
    "tests": { "enabled": true, "model": "sonnet" },
    "business": { "enabled": true, "model": "opus" },
    "performance": { "enabled": true, "model": "sonnet" }
  },
  "conventions": {
    "docs": [
      "docs/conventions.md",
      "docs/architecture.md",
      "docs/plugin-guide.md",
      "CONTRIBUTING.md",
      "CLAUDE.md"
    ]
  },
  "business": {
    "docs": [
      "docs/architecture.md",
      "docs/conventions.md"
    ]
  },
  "tdd": {
    "default": false,
    "desloppify": true,
    "coverageThreshold": 80
  },
  "instincts": {
    "enabled": true
  },
  "modelRouting": {
    "enabled": true,
    "override": {}
  },
  "autoCommit": true,
  "hooks": {
    "testOnSave": false
  },
  "isolation": {
    "plan": "worktree",
    "ship": "worktree",
    "quick": "branch"
  },
  "definitionOfDone": {
    "gatesPassing": true,
    "specReviewPassed": true,
    "stage2ReviewsPassed": true,
    "docCheckPassed": true,
    "screenshotReminder": "ui-changes"
  },
  "browser": {
    "enabled": true
  },
  "context": {
    "enabled": true,
    "autoRoute": true,
    "sandbox": {
      "timeout": 30000
    },
    "session": {
      "enabled": true
    }
  },
  "design": {
    "enabled": false
  },
  "signature": true,
  "repoMode": "solo",
  "challenge": "auto",
  "reviewScaling": true,
  "parallel": {
    "concurrency": 3,
    "maxBudgetPerSpec": 5.0
  },
  "plugins": []
}
