{
  "trusted": [
    {
      "key": "claude",
      "binary": "claude",
      "args": ["-p", "{prompt}", "--output-format", "stream-json", "--verbose", "--max-turns", "50"],
      "permission": {
        "plan": ["--permission-mode", "plan"],
        "default": ["--permission-mode", "default"],
        "acceptEdits": ["--permission-mode", "acceptEdits"],
        "bypass": ["--dangerously-skip-permissions"]
      },
      "reference": true,
      "probeOrder": 10
    },
    {
      "key": "codex",
      "binary": "codex",
      "args": ["exec", "--json", "--skip-git-repo-check", "--cd", "{cwd}", "{prompt}"],
      "permission": {
        "plan": ["--sandbox", "read-only"],
        "default": ["--sandbox", "workspace-write"],
        "acceptEdits": ["--sandbox", "workspace-write"],
        "bypass": ["--dangerously-bypass-approvals-and-sandbox"]
      },
      "reference": true,
      "probeOrder": 20
    },
    {
      "key": "kimi",
      "binary": "kimi",
      "args": ["--print", "-p", "{prompt}", "--output-format=stream-json"],
      "permission": {
        "plan": [],
        "default": [],
        "acceptEdits": ["--yolo"],
        "bypass": ["--yolo"]
      },
      "reference": true,
      "probeOrder": 30,
      "stopFromExit": true
    },
    {
      "key": "opencode",
      "binary": "opencode",
      "args": ["run", "--format", "json", "--", "{prompt}"],
      "permission": {
        "plan": [],
        "default": [],
        "acceptEdits": ["--dangerously-skip-permissions"],
        "bypass": ["--dangerously-skip-permissions"]
      },
      "reference": true,
      "probeOrder": 40,
      "stopFromExit": true
    }
  ]
}
