{
  "name": "mint-browser",
  "version": "0.1.0",
  "description": "Browser automation via PinchTab HTTP API — navigate, snapshot, interact, extract, review UI",
  "type": "infra",
  "agents": [
    "agents/browser-runner.md",
    "agents/browser-reviewer.md",
    "agents/browser-context.md",
    "agents/browser-debugger.md",
    "agents/browser-setup.md"
  ],
  "commands": [
    "commands/browse.md",
    "commands/screenshot.md",
    "commands/scrape.md"
  ],
  "config": {
    "browser": {
      "enabled": true,
      "baseUrl": "http://localhost:9867",
      "token": null,
      "headless": true,
      "devServer": "http://localhost:3000",
      "uiFilePatterns": ["*.vue", "*.tsx", "*.jsx", "*.svelte", "*.html", "*.css", "*.scss"],
      "reviewMode": "auto",
      "timeout": 30,
      "blockImages": false
    }
  },
  "hooks": {
    "pre-plan": "agents/browser-context.md",
    "post-plan": null,
    "pre-review": "agents/browser-reviewer.md",
    "post-commit": null,
    "on-init": "agents/browser-setup.md"
  }
}
